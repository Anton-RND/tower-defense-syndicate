# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ─── Хранилище ──────────────────────────────────────────────────────────────
# memory — инмемуарный стор (dev/тесты, БД не нужна), mongo — продакшн
STORE_DRIVER=memory
MONGODB_URI=mongodb://127.0.0.1:27017/tower_defense

# ─── Сессии ─────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО заменить в проде. Минимум 32 символа.
JWT_SECRET=dev-on…e-me
JWT_TTL_SECONDS=604800

# ─── Разрешённые источники (клиент в WebView) ───────────────────────────────
ALLOWED_ORIGINS=https://vk.com,https://vk.ru,http://localhost:5173

# ─── ВКонтакте (Шаг 1) ──────────────────────────────────────────────────────
# Оба значения берутся из настроек конкретного приложения в кабинете ВК, поэтому в
# примере они пустые: этот файл публикуется вместе с кодом, а привязка к приложению —
# нет. Заполняется только в среде продакшена (локальный стенд живёт на DEV_SIGNER).
# Заполнять по частям нельзя: GET /health считает флаг `vk` как appId > 0
# (server/src/http/app.ts:91), а авторизация — как appId > 0 && secretKey
# (isVkConfigured, server/src/config/env.ts:294). Один ID без ключа заставляет витрину поверить,
# что контейнер подключён, и отправляет игрока на маршрут, отвечающий 500 VK_NOT_CONFIGURED.
VK_APP_ID=
VK_SECRET_KEY=

*** ─── Telegram (Шаг 2, пока заглушка) ───────────────────────────────────────
TG_BOT_TOKEN=
*** Telegram Stars / Ad Controller — Шаг 5

# ─── Экономика: энергия (п.2.3) ─────────────────────────────────────────────
ENERGY_CAP=100
ENERGY_REGEN_PER_HOUR=5
# Восстановление за «Помощь друга» — 25% от капа
ENERGY_ASSIST_PERCENT=25
# Сколько раз в сутки можно восстановить энергию просьбами (анти-чит)
ENERGY_ASSIST_DAILY_LIMIT=4

# ─── Монетизация: rewarded-реклама (Шаг 1.5) ───────────────────────────────────
# Выключено, пока в кабинете VK не подключена монетизация рекламой.
# ВКЛЮЧАТЬ ТОЛЬКО после настройки серверного postback: награда выдаётся по факту,
# подтверждённому рекламной сетью, иначе это бесплатная фабрика энергии для ботов.
ADS_ENABLED=false
# Наград за рекламу в сутки (UTC) на игрока
ADS_DAILY_REWARDS=6
# Пауза между наградами, сек (анти-фарм)
ADS_MIN_INTERVAL_SEC=120
# Сколько живёт незакрытая сессия показа, сек (postback не пришёл — сгорела)
ADS_SESSION_TTL_SEC=180

# ─── Монетизация: покупки (Шаг 2: VK Pay / витрина) ────────────────────────────
# Выключено, пока в кабинете VK не настроены платежи и серверный endpoint приёма
# подтверждений (Часть 1: VKWebAppShowOrderBox + server-to-server postback).
# ВКЛЮЧАТЬ ТОЛЬКО после проверки подписи подтверждения: товар выдаётся по факту
# оплаты, подтверждённому площадкой, а не по просьбе клиента из WebView.
PAYMENTS_ENABLED=false
# Сколько раз в сутки можно купить один SKU (0 — без суточного лимита)
PURCHASE_DAILY_PER_SKU=0
# Потолок активных усилений в документе игрока (размер документа != бесконечность)
MAX_ACTIVE_ENTITLEMENTS=50
# Окно приёма возврата платежа, дни (после — refund отклоняем)
REFUND_WINDOW_DAYS=14
# Сколько живёт заказ, не подтверждённый площадкой, сек (потом сгорает)
PAYMENT_ORDER_TTL_SEC=900
# Сколько закрытых заказов храним в документе игрока (анти-дубль, тикеты)
PAYMENT_HISTORY=20

# ─── Кланы (Часть 2: основание за кританий, общая казна) ────────────────────────
# Сколько взносов в сутки UTC сдаёт один игрок (0 — без лимита)
CLAN_DAILY_DEPOSITS=20
# Сколько единиц металлов в сутки UTC сдаёт один игрок (0 — без лимита)
CLAN_DAILY_UNITS=100000
# Сколько живёт вклад в статусе pending, сек: за это время журнал обязан
# подтвердить списание у игрока, иначе вклад аннулируется
CLAN_PENDING_TTL_SEC=600

# ─── Экономика: псевдомайнинг (п.2.1, 2.2) ──────────────────────────────────
# Вместимость склада (ед.) — на каждый ресурс отдельно
STORAGE_CAPACITY=1000
# Стартовые ставки добычи, ед./час
MINING_RATE_FERRUM=50
MINING_RATE_SILICIUM=30
MINING_RATE_URANIUM=8
MINING_RATE_PLASMA=2
# Максимум накопления за время офлайна (защита от «вечного» lastLootTime)
MAX_OFFLINE_HOURS=72

# ─── PvP / Крафт (используется в шагах 3-4) ─────────────────────────────────
# Доля несобранных ресурсов, доступная грабителям (п.4.1)
LOOT_SHARE=0.3
# Роботов-строителей по умолчанию (п.3.1)
BUILD_ROBOTS_DEFAULT=2

# ─── Боевой лут и цех переработки (Шаг 1.6) ────────────────────────────────────
# Сколько боёв с выдачей лута засчитывается игроку за сутки UTC (0 — без лимита).
# Лут начисляет серверный резолвер боя; лимит — страховка от бота, гоняющего PvP 24/7.
LOOT_DAILY_EVENTS=50
# Потолок суммарного хлама на складе: упершись — игрок идёт сдавать в переработку.
# Это и антифрод-сток (нельзя накопить и отмыть), и мотиватор петли «бой → цех → чертёж».
JUNK_CAP=20000

# ─── Dev-инструменты (только НЕ в production) ───────────────────────────────
# true — разрешает POST /v1/dev/vk/sign (генерация initData для локальных тестов)
DEV_SIGNER_ENABLED=true
