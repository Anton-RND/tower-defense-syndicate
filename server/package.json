{
  "name": "@tds/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "description": "Tower Defense Syndicate (TDS): сервер экономики, PvP-рейдов, кланов и соцсетей. Копай. Добывай. Держи осаду.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vk:doctor": "node scripts/vk-init-data-doctor.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
